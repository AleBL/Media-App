{
  "name": "media-app",
  "version": "0.1.0",
  "description": "An Electron + Vue 3 starter project setup with Vite, Typescript, Vue-Router, Pinia, Eslint, Prettier, Tailwind CSS",
  "repository": "https://github.com/AleBL/Media-App",
  "author": {
    "name": "Alessandro",
    "url": "https://github.com/AleBL",
    "email": "ale_alessandro_ale@hotmail.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.12.1",
  "main": "dist-electron/main/index.js",
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:win": "vue-tsc --noEmit && vite build && electron-builder --win",
    "build:mac": "vue-tsc --noEmit && vite build && electron-builder --mac",
    "build:linux": "vue-tsc --noEmit && vite build && electron-builder --linux",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue,.ts --ignore-path .gitignore --fix src",
    "lint:check": "eslint --ext .js,.vue,.ts --ignore-path .gitignore src",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deps:update": "taze major -I"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/yargs": "^17.0.35",
    "@types/yargs-parser": "^21.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^10.11.1",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^21.0.4",
    "pinia": "^2.3.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.1",
    "sass": "^1.108.2",
    "tailwindcss": "^3.4.19",
    "taze": "^0.13.9",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.8",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^3.2.7",
    "vue": "^3.5.45",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  }
}
