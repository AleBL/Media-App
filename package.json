{
  "name": "media-app",
  "version": "0.1.0",
  "description": "An Electron + Vue 3 starter project setup with Vite, Typescript, Vue-Router, Pinia, Eslint, Prettier, Tailwind CSS",
  "repository": "https://github.com/AleBL/Media-App",
  "author": {
    "name": "Alessandro",
    "url": "https://github.com/AleBL",
    "email": "ale_alessandro_ale@hotmail.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@11.12.1",
  "main": "dist-electron/main/index.js",
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder",
    "build:win": "npm run typecheck && vite build && electron-builder --win",
    "build:mac": "npm run typecheck && vite build && electron-builder --mac",
    "build:linux": "npm run typecheck && vite build && electron-builder --linux",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deps:update": "taze major -I"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/minimatch": "^5.1.2",
    "@types/yargs": "^17.0.35",
    "@types/yargs-parser": "^21.0.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "pinia": "^4.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.1",
    "sass": "^1.108.2",
    "tailwindcss": "^3.4.19",
    "taze": "^0.13.9",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.0",
    "vue-tsc": "^3.3.14"
  }
}
