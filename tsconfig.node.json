{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "node_modules/.tmp/tsconfig.node"
  },
  "include": [
    "vite.config.mts",
    "vitest.config.mts",
    "electron",
    "config",
    "shared"
  ]
}
